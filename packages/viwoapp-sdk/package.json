{
  "name": "@viwoapp/sdk",
  "version": "3.0.0",
  "description": "TypeScript SDK for the VCoin programs: typed clients from the IDLs, PDA helpers, builders for staking + Realms, private polls, SSCRE claims, sessions, content, ViLink, identity and 5A",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "jest",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke"
  },
  "keywords": [
    "viwoapp",
    "vcoin",
    "solana",
    "blockchain",
    "sdk"
  ],
  "author": "ViWoApp Team",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@eslint/js": "^9.39.5",
    "@solana/web3.js": "^1.98.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "litesvm": "1.6.2",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
