{
  "name": "vcoin-workspace",
  "version": "3.0.0-dev",
  "private": true,
  "description": "ViWo protocol stack (VCoin) on Solana",
  "scripts": {
    "build": "anchor build",
    "build:no-idl": "anchor build --no-idl",
    "test": "anchor build && cargo test --workspace && npm run test:sdk",
    "test:rust": "cargo test --workspace",
    "test:integration": "cargo test -p integration-tests",
    "sync-idl": "node scripts/sync-idl.mjs",
    "test:sdk": "cd packages/viwoapp-sdk && npm test",
    "check": "cargo check --workspace",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint": "cd packages/viwoapp-sdk && npm run lint",
    "audit": "cargo audit"
  }
}
